# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only secret key (Project Settings > API Keys > Secret key). Lets the
# site read the Instagram token, which is hidden from public access.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Canonical site origin (defaults to https://www.zackproduction.com)
NEXT_PUBLIC_SITE_URL=https://www.zackproduction.com

# Optional: Google Analytics 4 measurement ID. Analytics only loads when set,
# and the privacy policy lists Google Analytics only when set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend (https://resend.com) - used to email the photographer when the contact form is submitted
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_NOTIFICATION_EMAIL=you@example.com

# Docker deployment only
# Your domain (DNS A record must point at the server). Caddy gets the HTTPS certificate for it.
DOMAIN=example.com
# Optional: protects /api/cron/keep-alive. Send it as "Authorization: Bearer <secret>"
CRON_SECRET=
